APP_NAME=Eagle Eye
POSTGRES_DB=eagle_eye
POSTGRES_USER=eagleeye
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://eagleeye:change-me@db:5432/eagle_eye
REDIS_URL=redis://redis:6379/0
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=your-opensky-client-secret
ENABLE_AISSTREAM=true
AISSTREAM_API_KEY=
AISSTREAM_BOUNDING_BOXES_JSON=[[[-90,-180],[90,180]]]
AISSTREAM_FILTER_MESSAGE_TYPES_JSON=[]
AISSTREAM_STALL_THRESHOLD_SECONDS=90
ENABLE_AISHUB=false
AISHUB_USERNAME=
AISHUB_PASSWORD=
AISHUB_POLL_INTERVAL_SECONDS=60
ENABLE_GFW=false
GFW_API_TOKEN=
GFW_POLL_INTERVAL_SECONDS=3600
CESIUM_ION_TOKEN=your-cesium-ion-token
ENABLE_SATELLITES=true
SATELLITE_DEFAULT_SOURCE=celestrak
CELESTRAK_GROUP=active
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
N2YO_API_KEY=
VITE_API_BASE_URL=http://localhost:8000
RETENTION_DAYS=7
