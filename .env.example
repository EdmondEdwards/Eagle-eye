APP_NAME=Eagle Eye v2
POSTGRES_DB=eagle_eye
POSTGRES_USER=eagle
POSTGRES_PASSWORD=eagle
DATABASE_URL=postgresql+psycopg://eagle:eagle@db:5432/eagle_eye
REDIS_URL=redis://redis:6379/0
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
AISSTREAM_BOUNDING_BOXES_JSON=[[[-90,-180],[90,180]]]
AISSTREAM_FILTER_MESSAGE_TYPES_JSON=[]
AISSTREAM_STALL_THRESHOLD_SECONDS=90
ENABLE_AISSTREAM=true
ENABLE_AISHUB=false
AISHUB_USERNAME=
AISHUB_PASSWORD=
AISHUB_POLL_INTERVAL_SECONDS=60
ENABLE_GFW=false
GFW_API_TOKEN=
GFW_POLL_INTERVAL_SECONDS=3600
ENABLE_SATELLITES=true
SATELLITE_DEFAULT_SOURCE=celestrak
CELESTRAK_GROUP=active,stations
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
N2YO_API_KEY=
CESIUM_ION_TOKEN=
VITE_API_BASE_URL=
RETENTION_DAYS=7
ENABLE_EONET=true
EONET_DEFAULT_STATUS=open
EONET_DEFAULT_DAYS=30
EONET_POLL_INTERVAL_SECONDS=900
EONET_USE_GEOJSON=true
ENABLE_FIRMS=true
FIRMS_MAP_KEY=
FIRMS_POLL_INTERVAL_SECONDS=300
FIRMS_DEFAULT_LOOKBACK_DAYS=2
FIRMS_ENABLE_CLUSTERING=true
FIRMS_SENSORS=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,MODIS_NRT
FIRMS_AOI_BBOXES_JSON=[]
FIRMS_GLOBAL_TILE_STEP_DEGREES=20
FIRMS_MAX_TILES=72
ENABLE_NWS=true
NWS_POLL_INTERVAL_SECONDS=300
NWS_ALERTS_ONLY=true
